{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentrust-io.com/schema/integration.schema.json",
  "title": "agentrust-io integration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "vendor", "integrates_with", "description", "maintainer", "repository", "license", "tier", "marketplace"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "Product or project name."
    },
    "vendor": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "Company or community project behind the integration."
    },
    "integrates_with": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["cmcp", "trace", "agent-manifest", "wcm", "ca2a"]
      },
      "description": "Which parts of the stack this integrates with."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "One technical sentence. No marketing superlatives; claims must be verifiable."
    },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$",
          "description": "GitHub username accountable for this integration."
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://",
      "description": "Canonical home of the integration's source."
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "description": "Optional product page. Marketing lives here, not in the README."
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "description": "SPDX identifier of the integration directory's license."
    },
    "tier": {
      "type": "string",
      "enum": ["community", "verified"],
      "description": "Set by maintainers during review, never self-declared. New submissions use community."
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "mark"],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Optional human-facing name when the package identifier is not suitable for display."
        },
        "category": {
          "type": "string",
          "enum": ["Compliance", "Developer tools", "Evidence & receipts", "Frameworks", "Identity & trust", "Model & weight custody", "Observability", "Security & policy"]
        },
        "mark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Za-z0-9$]+$",
          "description": "Short text mark shown when a listing has no approved logo asset."
        },
        "featured": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Optional maintainer-curated display order; lower values appear first."
        },
        "keywords": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 32 }
        }
      },
      "description": "Discoverability metadata for the AgenTrust Marketplace."
    },
    "trace_conformance_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Required if the integration emits or consumes TRACE records: the agentrust-trace-tests level it passes."
    },
    "trace_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["record-producer", "record-consumer", "external-evidence-source"]
      },
      "description": "How the integration relates to TRACE. Evidence sources do not claim to emit or verify TRACE records."
    },
    "wcm_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["manifest-producer", "manifest-verifier", "key-broker", "protected-runtime", "attestation-source", "evidence-consumer"]
      },
      "description": "How the integration relates to WCM. An attestation source produces evidence but verifies no manifest; an evidence consumer reads custody output and makes no cryptographic claim of its own."
    },
    "wcm_conformance_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["L1", "L2", "L3", "L4"]
      },
      "description": "Required if the integration produces, verifies, brokers, or holds WCM material: the `wcm conformance` levels it passes. WCM levels are per-layer, so an integration may cover L1 without claiming L2."
    },
    "tested_against": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cmcp-runtime": { "type": "string" },
        "agentrust-trace": { "type": "string" },
        "agentrust-trace-tests": { "type": "string" },
        "agent-manifest": { "type": "string" },
        "weight-custody-manifest": { "type": "string" }
      },
      "description": "Released package versions the integration was last tested against."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "integrates_with": { "contains": { "const": "trace" } }
        },
        "required": ["integrates_with"]
      },
      "then": { "required": ["trace_roles"] }
    },
    {
      "if": {
        "properties": {
          "trace_roles": {
            "contains": { "enum": ["record-producer", "record-consumer"] }
          }
        },
        "required": ["trace_roles"]
      },
      "then": { "required": ["trace_conformance_level"] }
    },
    {
      "if": {
        "properties": {
          "integrates_with": { "contains": { "const": "wcm" } }
        },
        "required": ["integrates_with"]
      },
      "then": { "required": ["wcm_roles"] }
    },
    {
      "if": {
        "properties": {
          "wcm_roles": {
            "contains": { "enum": ["manifest-producer", "manifest-verifier", "key-broker", "protected-runtime"] }
          }
        },
        "required": ["wcm_roles"]
      },
      "then": { "required": ["wcm_conformance_levels"] }
    }
  ]
}
